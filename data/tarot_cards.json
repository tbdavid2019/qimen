  "numerology": {
    "1": {
      "card": "魔術師",
      "summary": "充滿能量的巫師，溝通天地的創造者。對事物熱情積極、善於溝通、樂於幫朋友解決事情。要注意言語犀利需藏拙，以及朋友間的分際。"
    },
    "2": {
      "card": "女祭司",
      "summary": "深藏智慧、冷靜沉著、直覺敏銳、洞察力透徹。對事物的看法比一般人深入。要注意冷靜的態度在戀愛上容易造成距離感。"
    },
    "3": {
      "card": "皇后",
      "summary": "母性與愛情。熱情有愛心、很有母愛；愛情是人生中重要的功課，一旦投入便充滿希望與熱情。要注意熱情勿過頭、愛心適度，以免雙方壓力。"
    },
    "4": {
      "card": "皇帝",
      "summary": "責任、努力與掌控。靠自己的努力獲得成功，居安思危、步步為營。要注意不要太自我，以免與人相處產生距離感。"
    },
    "5": {
      "card": "教皇",
      "summary": "智慧、傳統與引領。內心有定見、對未來自有規劃並勇於實踐，樂於成為別人的引領者，適合團體合作。要注意過於保守，不容別人評斷專業。"
    },
    "6": {
      "card": "戀人",
      "summary": "抉擇與關係。對異性有吸引力、思考敏捷、善於判斷，以樂觀正面的方式待人。要注意愛情容易沖昏頭，衝動的決定易引發不良後果。"
    },
    "7": {
      "card": "戰車",
      "summary": "意志與征服。喜歡競爭、以競賽為進步動力，重視家人與自己人，第一名是唯一目標。要注意以智、仁、勇合一，勿用爭鬥心態對待周遭。"
    },
    "8": {
      "card": "力量",
      "summary": "以溫柔馴服內在的獸性。光芒四射、樂於散發光和熱。人生課題是降服內在的陰暗面，讓內心的神性與獸性自由溝通、達到平衡。"
    },
    "9": {
      "card": "隱者",
      "summary": "尋求智慧的引領者。很有智慧、可做為周遭人的心靈安慰者，帶來安定平和。要注意過度內省會壓力沉重，過度追求自我易憤世嫉俗。"
    }
  },
