# ==============================================================================
# LLM 核心配置 (第一順位: https://llm.aiurl.tw/v1 / group/talk)
# ==============================================================================
LLM_PROVIDER=openai
LLM_BASE_URL=https://llm.aiurl.tw/v1
LLM_MODEL=group/talk
LLM_MODELS=group/talk
LLM_API_KEY=sk-magpie-key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多模型 fallback（由左至右依序嘗試；設定後優先於 LLM_MODEL）
# LLM_MODELS=group/talk,openai/gpt-oss-120b,gemini-3.8-flash
# 或保留主要模型，另外追加備援模型：
# LLM_FALLBACK_MODELS=openai/gpt-oss-120b,gemini-3.8-flash

# ==============================================================================
# 郵件發送服務 (Resend API - Vercel Serverless Function 隔離)
# ==============================================================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=333 一句提醒·照見當下 <onboarding@resend.dev>

# ==============================================================================
# 社群與通知 Webhook
# ==============================================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ==============================================================================
# Cloudflare Turnstile 人機驗證配置（預設未啟用，填入真實密鑰方自動啟用）
# ==============================================================================
TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET=0x4AAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TURNSTILE_HOSTNAMES=qi.david888.com,localhost,127.0.0.1
# 可選：繞過 Token（用於受信任的 CLI / 內部自動化呼叫）
# TURNSTILE_BYPASS_TOKEN=your-internal-secret-token

# 應用端口
PORT=3000

# ==============================================================================
# 支援的 LLM 配置範例：
# ==============================================================================
# OpenAI 官方配置
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Anthropic Claude 配置
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=claude-3-haiku-20240307

# 本地 Ollama 配置
# LLM_PROVIDER=ollama
# LLM_API_KEY=not_required
# LLM_MODEL=llama3.1:latest
# LLM_BASE_URL=http://localhost:11434/v1

# Groq 配置
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=openai/gpt-oss-120b
